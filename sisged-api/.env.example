APP_NAME="SISGED API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sisged
DB_USERNAME=root
DB_PASSWORD=

# --- Configurações do L5-Swagger ---
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8000/api
L5_FORMAT_TO_USE_FOR_DOCS=json
